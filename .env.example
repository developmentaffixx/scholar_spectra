# ===== Scholar Spectra Backend — Environment Template =====
# Copy this file to ".env" on the server and fill in REAL values.
# NEVER commit the real .env file to Git.

# Server
PORT=5000

# MySQL Database (use the Hostinger-provided DB host/user/name)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=scholar_spectra
DB_PORT=3306

# Staff Portal Admin + Notification Email
ADMIN_LOGIN_ID=Scholar Spectra
ADMIN_EMAIL=admissions@scholarspectra.com
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFICATION_EMAIL=admissions@scholarspectra.com
REPLY_TO_EMAIL=admissions@scholarspectra.com

# Public backend origin — used to build the email logo URL (/assets/logo.png)
PUBLIC_SERVER_URL=https://ssb.affixxmedia.com

# Google Spreadsheet Configuration
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_app_script_deployment_id/exec

# Frontend App URL (for CORS and password reset links)
# POC frontend is hosted at poc.affixxmedia.com
FRONTEND_URL=https://poc.affixxmedia.com
